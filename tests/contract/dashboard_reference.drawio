<?xml version="1.0" encoding="UTF-8"?>
<mxfile dashboardVersion="0" host="modelica_dashboard">
  <diagram name="Demo" id="dashboard">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="w-speed" type="gauge" variable="motor.speed" label="Vitesse" UserObject="1" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="w-on" type="button" variable="motor.on" label="Marche" UserObject="1" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="w-curve" type="curve" variable="motor.speed" label="Historique" UserObject="1" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="360" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="w-log" type="log" variable="" label="Journal" UserObject="1" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="360" height="180" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
